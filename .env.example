# ── RXM Automobile / ParcOS — Environment Configuration ───────────────────
#
# Netcup VPS Micro-API & PostgreSQL Connection:
# Toate datele, vehiculele și fotografiile sunt gestionate direct pe Netcup VPS (152.53.158.65).
#

# URL-ul țintă pentru proxy API în mod de dezvoltare local:
VITE_API_TARGET=https://rxmautomobile.ro

# Backend Node.js Micro-API Server Configuration (server/api.mjs):
PORT=3001
DEALER_SLUG=rxm
DATABASE_URL=postgres://rxm_admin:secret_password@127.0.0.1:5432/rxm_automobile
ADMIN_API_KEY=generate_a_random_32_character_hex_secret_here
ADMIN_PASSWORD_HASH=sha256_of_admin_password
GEMINI_API_KEY=your_google_gemini_api_key_for_ocr
SUPERADMIN_MASTER_KEY=parcos_superadmin_dev_secret_2026

# Chei opționale Google Gemini pentru mediul de dezvoltare frontend:
VITE_GEMINI_API_KEYS=

# ── ParcOS Mail Hub — Enterprise Hybrid Infrastructure (PMH-105) ─────────────
#
# 1. AWS SES & S3 Inbound/Outbound (eu-north-1):
# S3-First: EML brut stocat temporar în bucket S3 fără trunchiere payload.
AWS_SES_REGION=eu-north-1
AWS_SES_ACCESS_KEY_ID=AKIA_YOUR_AWS_SES_ACCESS_KEY
AWS_SES_SECRET_ACCESS_KEY=your_aws_ses_secret_access_key
AWS_S3_BUCKET_INBOUND=parcos-ses-inbound-temp

# 2. AWS SNS Inbound Webhook Notifications:
# Topic-ul pe care SES publică notificările de primire e-mail (Receipt Rule Set).
AWS_SNS_TOPIC_ARN=arn:aws:sns:eu-north-1:123456789012:parcos-ses-inbound-notifications
AWS_SNS_SECRET=your_sns_webhook_signature_verification_secret_if_applicable

# 3. Google Drive Vault (Cold Storage & Permanent Archive):
# Serviciu de arhivare gratuită pe Google Drive API v3 via Service Account.
# GDRIVE_SERVICE_ACCOUNT_JSON conține credențialele JSON codificate base64:
# Comandă generare: cat service-account.json | base64 -w 0
GDRIVE_SERVICE_ACCOUNT_JSON=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6Ii4uLiJ9
GDRIVE_VAULT_ROOT_FOLDER_ID=your_google_drive_folder_id_for_parcos_vault_root

# 4. Master Key Criptare AES-256-GCM la Repaus:
# Cheie master de 32 bytes hex (64 caractere hexadecimale) pentru derivarea
# cheilor specifice per dealer prin HMAC-SHA256(VAULT_MASTER_KEY, dealer_id).
# Comandă generare: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
VAULT_MASTER_KEY=generate_a_random_64_character_hex_string_here_32_bytes_aes_gcm

# 5. Web Push VAPID Keys (Notificări PWA Mobile pe Telefon):
# Comandă generare: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BFx...your_public_vapid_key_base64url...
VAPID_PRIVATE_KEY=your_private_vapid_key_base64url

# 6. Cloudflare R2 Ultra-Fast Media Storage (Zero Egress, Free Tier 10GB):
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=parcos-media
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.eu.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
